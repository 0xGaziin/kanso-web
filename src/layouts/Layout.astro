---
import '@fontsource-variable/inter';
import '../styles/global.css';

// Components
import DownloadButton from '../components/DownloadButton.astro';

interface Props {
	title?: string;
	lang?: string;
}

const {
	title = 'Kanso - Efficiency and privacy: the Kanso standard.',
	lang = 'en',
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
</head>
<body>
	<header>
		<nav aria-label="Primary">
			<a href="/" class="brand">
				<svg width="22" height="22" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<rect width="64" height="64" rx="14" fill="#dcd6c8" fill-opacity="0.1"/>
					<path d="M22 18V46" stroke="#dcd6c8" stroke-width="5" stroke-linecap="round"/>
					<path d="M42 18L27 32L42 46" stroke="#dcd6c8" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
					<line x1="27" y1="32" x2="20" y2="39" stroke="#dcd6c8" stroke-width="2.5" stroke-linecap="round"/>
				</svg>
				<span>Kanso</span>
			</a>

			<ul class="nav-links">
				<li><a href="#getting-started">Getting Started</a></li>
				<li><a href="/docs">Documents</a></li>
				<li><a href="/donate">Donate</a></li>
			</ul>

			<DownloadButton />
		</nav>
	</header>

	<main>
		<slot />
	</main>
</body>
</html>